{
 "connector.class": "io.debezium.connector.oracle.OracleConnector",
    "tasks.max": "1",

    "database.hostname": "oracle",
    "database.port": "1521",
    "database.user": "C##DBZUSER",
    "database.password": "DbzUserPass123",
    "database.dbname": "xepdb1",
    "database.pdb.name": "XEPDB1",

    "topic.prefix": "oracle21",
    "database.connection.adapter": "logminer",
    
    "snapshot.mode": "initial",
    "table.include.list": "APPUSER.STMT_ENTRY",

    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false", 
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    
    "include.schema.changes": "true",
    "decimal.handling.mode": "precise",
    "time.precision.mode": "adaptive",
    
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "schema.history.internal.kafka.topic": "schemahistory.oracle21",

    "log.mining.continuous.mine": "true",
    "log.mining.select.all.tables": "false",
    "log.mining.include.regex.table.list": "APPUSER.STMT_ENTRY",
    "log.mining.strategy": "online_catalog",

    "lob.enabled": "true",
    "lob.chunk.size": "102400",
    "lob.erase.poll.interval.ms": "0",
    
    "database.fetch.size": "5000",
    "jdbc.lob.chunk.size": "102400",
    "jdbc.batch.size": "20000",
    "binary.handling.mode": "base64",

    "datatype.propagate.source.type": "APPUSER.STMT_ENTRY:TXN_METADATA",

    "include.unknown.datatypes": "true",
    "post.processors": "reselectColumns",
    "post.processors.reselectColumns.type": "io.debezium.processors.reselect.ReselectColumnsPostProcessor",
    "post.processors.reselectColumns.reselect.columns.include.list": "APPUSER.STMT_ENTRY:AUDIT_TRAIL,APPUSER.STMT_ENTRY:DIGITAL_RECEIPT",
    
    "provide.transaction.metadata": "false",
    "snapshot.locking.mode": "none"
}