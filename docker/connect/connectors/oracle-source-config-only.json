{
  "connector.class": "io.debezium.connector.oracle.OracleConnector",
  "tasks.max": "1",

  "database.hostname": "oracle",
  "database.port": "1521",
  "database.user": "C##DBZUSER",
  "database.password": "DbzUserPass123",
  "database.dbname": "xepdb1",
  "database.pdb.name": "XEPDB1",

  "topic.prefix": "oracle21",
  "database.connection.adapter": "logminer",
  "lob.enabled": "true",

  "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
  "schema.history.internal.kafka.topic": "schemahistory.oracle21",

  "snapshot.mode": "initial",
  "table.include.list": "APPUSER.CDC_MAIN_TABLE",
  "log.mining.strategy": "online_catalog",
  "key.converter": "org.apache.kafka.connect.json.JsonConverter",
  "key.converter.schemas.enable": "false",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",

  "include.schema.changes": "true",
  "include.unknown.datatypes": "false",
  "decimal.handling.mode": "precise",
  "time.precision.mode": "adaptive",
  "log.mining.continuous.mine": "true",
  "lob.erase.poll.interval.ms": "0",

  "post.processors": "reselectColumns",
  "post.processors.reselectColumns.type": "io.debezium.processors.reselect.ReselectColumnsPostProcessor",
  "post.processors.reselectColumns.reselect.columns.include.list": "APPUSER.CDC_MAIN_TABLE:xmlrecord"
}